{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Rust counter",
      "cargo": {
        "args": [
          "build",
          "--package",
          "cove-rust-counter"
        ],
        "filter": {
          "name": "cove-rust-counter",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Process fixture",
      "cargo": {
        "args": [
          "build",
          "--package",
          "cove-system",
          "--bin",
          "cove_process_fixture"
        ],
        "filter": {
          "name": "cove_process_fixture",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
