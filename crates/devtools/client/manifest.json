{
  "description": "Ordered parts of the served Inspector assets. /index.html, /inspector.css and /inspector.js are each the byte-for-byte concatenation of their parts, in the order listed below. Module parts share one module scope; they are not standalone ES modules.",
  "bundles": [
    {
      "path": "/index.html",
      "root": "markup",
      "media": "text/html; charset=utf-8",
      "parts": [
        "head.html",
        "shell.html",
        "views/inspector.html",
        "views/network.html",
        "views/logs.html",
        "views/state.html",
        "views/extensions.html",
        "views/performance.html",
        "views/memory.html",
        "views/app-size.html",
        "views/deep-links.html",
        "views/debugger.html",
        "dialogs.html",
        "tail.html"
      ]
    },
    {
      "path": "/inspector.css",
      "root": "css",
      "media": "text/css; charset=utf-8",
      "parts": [
        "base.css",
        "shell/header.css",
        "shell/layout.css",
        "shell/setup.css",
        "inspector/toolbar.css",
        "inspector/grid.css",
        "inspector/states.css",
        "inspector/details.css",
        "inspector/screenshot.css",
        "inspector/detail-tabs.css",
        "inspector/flex-explorer.css",
        "inspector/input-drawer.css",
        "panels/aux.css",
        "panels/performance.css",
        "panels/performance/cpu-profile.css",
        "panels/performance/cpu-profile-views.css",
        "panels/memory.css",
        "panels/app-size.css",
        "panels/deep-links.css",
        "panels/debugger.css",
        "shell/modal.css",
        "shell/toast.css",
        "shell/scrollbars.css",
        "shell/responsive.css"
      ]
    },
    {
      "path": "/inspector.js",
      "root": "src",
      "media": "text/javascript; charset=utf-8",
      "parts": [
        "core/globals.js",
        "core/format.js",
        "core/session.js",
        "core/debug-paint.js",
        "core/ui-helpers.js",
        "inspector/tree.js",
        "inspector/editors.js",
        "inspector/capture.js",
        "inspector/input.js",
        "panels/network.js",
        "panels/logs.js",
        "panels/performance/overview.js",
        "panels/performance/frames.js",
        "panels/performance/timeline.js",
        "panels/performance/snapshots.js",
        "panels/performance/profile/model.js",
        "panels/performance/profile/control.js",
        "panels/performance/profile/trees.js",
        "panels/performance/profile/views.js",
        "panels/memory/snapshot.js",
        "panels/memory/sampling.js",
        "panels/memory/baselines.js",
        "panels/memory/view.js",
        "panels/state.js",
        "panels/extensions.js",
        "panels/app-size/model.js",
        "panels/app-size/sections.js",
        "panels/app-size/treemap.js",
        "panels/app-size/diff.js",
        "panels/deep-links/model.js",
        "panels/deep-links/view.js",
        "panels/debugger/model.js",
        "panels/debugger/session.js",
        "panels/debugger/view.js",
        "shell/views.js",
        "shell/events.js",
        "shell/boot.js"
      ]
    }
  ]
}
