#!/bin/sh
set -eu
COVE_CHECKOUT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
COVE_SDK_ROOT=${COVE_SDK_ROOT:-$COVE_CHECKOUT}
export COVE_SDK_ROOT
COVE_SOURCE_SWIFT=${COVE_SWIFT_EXECUTABLE:-swift}
"$COVE_SOURCE_SWIFT" build --package-path "$COVE_CHECKOUT/Tools/Cove" --product cove --jobs 4
COVE_SOURCE_PRODUCTS=$("$COVE_SOURCE_SWIFT" build --package-path "$COVE_CHECKOUT/Tools/Cove" --show-bin-path)
# Keep the caller's environment when the CLI launches the compiler itself.
exec "$COVE_SOURCE_PRODUCTS/cove" "$@"
