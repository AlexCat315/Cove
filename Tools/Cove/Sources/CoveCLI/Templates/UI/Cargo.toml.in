[package]
name = "cove-application"
version = "0.1.0"
edition = "2024"
rust-version = "1.90"
publish = false

[workspace]

[dependencies]
# Point this at the Cove checkout (or a path inside the installed SDK).
cove-ui = { path = "{{COVE_UI_PATH}}" }

[[bin]]
name = "cove-application"
path = "src/main.rs"

[[test]]
name = "appcontent_resources"
path = "Tests/appcontent_resources.rs"

[profile.release]
lto = "thin"
codegen-units = 1
